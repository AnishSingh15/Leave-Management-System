# Environment Variables for LAMS
# Copy this file to .env.local and fill in your Firebase configuration

# Firebase Configuration (add these in .env.local AND in Vercel dashboard)
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Slack Webhook (add ONLY in Vercel dashboard as server-side env var)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ─── Holiday Reminder Email (add in Vercel dashboard as server-side env vars) ──
# Zoho Mail SMTP credentials:
#   ZOHO_EMAIL    — the Zoho address emails are sent from (e.g. hr@getmorph.com)
#   ZOHO_PASSWORD — your Zoho account password, OR a Zoho App Password if 2FA is on
#                   (accounts.zoho.com → Security → App Passwords → Generate New)
# ZOHO_EMAIL=hr@getmorph.com
# ZOHO_PASSWORD=your_zoho_password
#
# Any random secret string — used to protect the /api/holiday-reminder endpoint
# Generate one with: openssl rand -hex 32
# CRON_SECRET=your_random_secret_here
