{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": null,
  "crons": [
    {
      "path": "/api/holiday-reminder",
      "schedule": "30 4 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
